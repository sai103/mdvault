{
  "name": "mdvault",
  "version": "1.0.0",
  "description": "Cloudflare 上で動く個人用 Markdown ノートアプリ (Obsidian 風)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mdvault --local",
    "db:reset:local": "node scripts/reset-local.mjs && npm run db:migrate:local",
    "db:migrate": "wrangler d1 migrations apply mdvault --remote",
    "dev": "node scripts/dev.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc",
    "test": "vitest run",
    "audit": "npm audit --omit=dev",
    "test:e2e": "playwright test"
  },
  "author": "",
  "license": "0BSD",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "marked": "^18.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
