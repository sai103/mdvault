{
  "name": "mdvault",
  "version": "1.0.0",
  "description": "Cloudflare 上で動く個人用 Markdown ノートアプリ (Obsidian 風)",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mdvault --local",
    "db:reset:local": "node scripts/reset-local.mjs && npm run db:migrate:local",
    "db:migrate": "wrangler d1 migrations apply mdvault --remote",
    "dev": "npm run vendor && wrangler dev",
    "deploy": "npm run vendor && wrangler deploy",
    "typecheck": "tsc",
    "test": "vitest run",
    "audit": "npm audit --omit=dev"
  },
  "author": "",
  "license": "0BSD",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "dompurify": "^3.4.17",
    "marked": "^15.0.12"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
